{
  "name": "pursae-web-builder",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Build workspace for the Pursae Web Builder editor and site runtime (sources: upstream/ submodule + patches/ + host/). Output: ../web/web-builder/.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "audit": "node test/audit.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "gen:themes": "vitest run --config vitest.gen.config.ts"
  },
  "dependencies": {
    "@fontsource/instrument-serif": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "lucide-react": "1.80.0",
    "motion": "14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "26.6.8",
    "@types/react": "19.3.1",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "typescript-api": "npm:typescript@5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
