+/** The site style (host seam): follow it, save this design's look as it, or go back to it. */
+function SiteStylePanel() {
+  const b = useB()
+  const seam = useSiteStyleSeam()
+  const [busy, setBusy] = useState(false)
+  if (!seam) return null
+  const site = b.doc.site
+  const style = seam.value
+  const following = !!site.global && !!style
+  const differs = !style || !sameStyle(site, style)
+  const save = async () => {
+    setBusy(true)
+    try {
+      const msg = await seam.save(styleOf(site))
+      b.dispatch({ type: 'site', patch: { global: true } })
+      b.notify(msg || t('Site style saved'))
+    } catch (e) {
+      b.notify(e instanceof Error ? e.message : String(e))
+    } finally {
+      setBusy(false)
+    }
+  }
+  const btn = 'h-7 rounded-[5px] bg-white/[0.06] px-2.5 text-[11.5px] font-medium text-ink-200 hover:bg-white/10 disabled:opacity-50'
+  return (
+    <Panel title={t('Site style')}>
+      {style ? (
+        <Ctl label={t('Follow the site style')}>
+          <Toggle on={following} label={t('Follow the site style')} onChange={(on) => b.dispatch({ type: 'site', patch: on ? followStyle(style) : { global: false } })} />
+        </Ctl>
+      ) : null}
+      <p className="text-[11px] leading-relaxed text-ink-400">
+        {!style
+          ? t('No site style yet. Save this design’s colors, fonts and corners as the site style; pages and templates that follow it share them.')
+          : following
+            ? t('This design uses the site style’s colors, fonts and corners. Changing one here stops following it.')
+            : t('This design has its own colors, fonts and corners.')}
+      </p>
+      {(seam.canEdit && differs) || (style && differs && !following) ? (
+        <div className="flex flex-wrap gap-1.5">
+          {seam.canEdit && differs && (
+            <button type="button" disabled={busy} onClick={save} className={btn}>
+              {t('Save as site style')}
+            </button>
+          )}
+          {style && differs && !following && (
+            <button type="button" onClick={() => b.dispatch({ type: 'site', patch: followStyle(style) })} className={btn}>
+              {t('Use the site style')}
+            </button>
+          )}
+        </div>
+      ) : null}
+    </Panel>
+  )
+}
