diff --git a/src/builder/siteStyleHost.ts b/src/builder/siteStyleHost.ts
new file mode 100644
index 0000000..a9aae14
--- /dev/null
+++ b/src/builder/siteStyleHost.ts
@@ -0,0 +1,60 @@
+import { useSyncExternalStore } from 'react'
+import type { SiteSettings } from './types'
+
+/**
+ * Host seam of the site style (Pursae Web Builder): one brand colour, font pair, fonts and
+ * corners for the whole site. A design whose `site.global` is true follows it: it starts with the
+ * site style, and the host puts the current style into it whenever it is loaded. Absent in the
+ * standalone builder, so the Globals panel shows no site style controls.
+ */
+export type SiteStyle = Omit<SiteSettings, 'global'>
+
+export interface SiteStyleSeam {
+  /** The site style, or null while none was saved. */
+  value: SiteStyle | null
+  /** The user may change the site style (save); everyone may follow it. */
+  canEdit: boolean
+  /** Saves the site style; resolves with the text to show (e.g. how many pages to regenerate). */
+  save(style: SiteStyle): Promise<string>
+}
+
+let seam: SiteStyleSeam | null = null
+const subs = new Set<() => void>()
+
+export function setSiteStyleSeam(next: SiteStyleSeam | null) {
+  seam = next
+  subs.forEach((f) => f())
+}
+
+export const getSiteStyleSeam = () => seam
+
+const subscribe = (f: () => void) => {
+  subs.add(f)
+  return () => subs.delete(f)
+}
+export const useSiteStyleSeam = () => useSyncExternalStore(subscribe, () => seam)
+
+const KEYS = ['brand', 'fontPair', 'corners', 'headingFont', 'headingWeight', 'bodyFont', 'bodyWeight'] as const
+
+/** The style part of a design's site settings (no `global`, no unset keys). */
+export function styleOf(site: SiteSettings): SiteStyle {
+  const out: Record<string, unknown> = {}
+  for (const k of KEYS) if (site[k] !== undefined && site[k] !== '') out[k] = site[k]
+  return out as SiteStyle
+}
+
+/** True when the design's colours, fonts and corners are the site style's. */
+export function sameStyle(site: SiteSettings, style: SiteStyle): boolean {
+  const a = styleOf(site)
+  const b = styleOf(style as SiteSettings)
+  return KEYS.every((k) => a[k] === b[k])
+}
+
+/** The site settings of a design that follows the site style. */
+export const followStyle = (style: SiteStyle): SiteSettings => ({ ...styleOf(style as SiteSettings), global: true })
+
+/** A new design starts with the site style, when there is one. */
+export function withSiteStyle<T extends { site: SiteSettings }>(doc: T): T {
+  const style = seam?.value
+  return style ? { ...doc, site: followStyle(style) } : doc
+}
