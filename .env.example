# Pursae — settings for docker-compose.yml (official production stack).
#
#   cp .env.example .env          # .env is ignored by git
#   docker compose up -d --build
#
# Required: WPGO_DB_PASSWORD and WPGO_SITE_URL. Everything else has a safe default.
# Full reference: docs/developer/operations/configuration.md

# ─── Required ────────────────────────────────────────────────────────────────────────────────────

# Database password. Applied once, when the database volume is created (to change it later run
# ALTER USER wpgo PASSWORD '...' first). Letters and digits keep the URL simple.
# Generate one with: openssl rand -hex 24
WPGO_DB_PASSWORD=

# Public address of the site as visitors reach it, without a trailing slash: https://example.com behind
# your TLS proxy, or http://localhost:8088 to try it on this machine. Written into the settings by the
# installer, so set it before the first run.
WPGO_SITE_URL=http://localhost:8088

# ─── Installation and secrets ────────────────────────────────────────────────────────────────────

# Setup token that locks the installer (/wp-admin/install) so only you can create the first admin.
# Empty: the server generates one on first start and prints the install link in its log:
#   docker compose logs pursae | grep install
# Or set your own long random value (openssl rand -hex 24) and enter it on the install screen.
# Lost the link?  docker compose exec pursae wpgo setup-token
# It stops working once the site is installed.
WPGO_SETUP_TOKEN=

# Secret for session cookies, nonces and encrypted settings. Empty: generated on first start and kept in
# the database. Set it (openssl rand -hex 32) when several instances share one database.
WPGO_SECRET=

# ─── Pursae Manager (hub.pursae.com) ─────────────────────────────────────────────────────────────

# 1 (default): core updates, marketplace, themes library and licenses from hub.pursae.com.
# off: never contact the Hub (no updates, marketplace or licenses; every admin page warns). Not recommended.
WPGO_HUB=1

# ─── Network and proxy ───────────────────────────────────────────────────────────────────────────

# Host address and port the site is published on. Keep 127.0.0.1 and put Caddy/nginx/Traefik on this host.
# 0.0.0.0 opens the port to the network: then set WPGO_TRUSTED_PROXIES to exactly your proxy's address.
WPGO_BIND=127.0.0.1
WPGO_PORT=8088

# Proxies (comma-separated IPs or CIDRs) whose X-Forwarded-For / X-Real-IP is believed.
# Empty: loopback and private networks (includes the Docker bridge a host proxy comes from); none: nobody.
WPGO_TRUSTED_PROXIES=

# ─── Outgoing mail ───────────────────────────────────────────────────────────────────────────────

# Password resets, new-user and comment notifications. Without a host, messages are only written as
# .eml files to the mail volume. Port 465 = implicit TLS, anything else = STARTTLS when offered.
WPGO_SMTP_HOST=
WPGO_SMTP_PORT=587
WPGO_SMTP_USER=
WPGO_SMTP_PASS=
# Sender, e.g. "My Site <hello@example.com>". Default: <Site Title> <wordpress@your-host>.
WPGO_MAIL_FROM=

# ─── Security (optional) ─────────────────────────────────────────────────────────────────────────

# Extra trusted plugin signing keys (base64 Ed25519, comma separated).
WPGO_PLUGIN_KEYS=
# 1: Theme File Editor is read-only (like DISALLOW_FILE_EDIT).
WPGO_DISALLOW_FILE_EDIT=
# 1: visitors may list accounts (REST users, /?author=N, users sitemap). Off by default.
WPGO_EXPOSE_USERS=
# off: disable the Pursae firewall (WAF) entirely. Leave empty.
WPGO_FIREWALL=
# Recovery switch: 1 brings /wp-login back if you lost Pursae Security's custom login URL. Leave empty.
WPGO_ADMINSEC_DISABLE_HIDE_LOGIN=

# ─── Content and operations (optional) ───────────────────────────────────────────────────────────

# Revisions kept per post (default 25; negative keeps all).
WPGO_POST_REVISIONS=
# Days trashed posts/comments are kept (default 30).
WPGO_EMPTY_TRASH_DAYS=
# json: access log as one JSON object per request (for log shippers).
WPGO_LOG_FORMAT=
# off: stop the monthly DB-IP country database download.
WPGO_GEOIP_UPDATE=
# Pursae CDN settings as one JSON object, e.g. {"provider":"aws","bucket":"media",...}; overrides saved settings.
WPGO_CDN_SETTINGS=

# ─── Build and Compose (optional) ────────────────────────────────────────────────────────────────

# Core version the binary reports, e.g. 0.4.0.
WPGO_VERSION=
# Tag for the locally built image.
PURSAE_IMAGE=pursae:local
# Database name and user (only applied when the database volume is created).
WPGO_DB_NAME=wpgo
WPGO_DB_USER=wpgo
# Compose project name (prefix of the volumes). Set wpgo to reuse the volumes of an existing
# `make prod-up` install.
# COMPOSE_PROJECT_NAME=pursae
